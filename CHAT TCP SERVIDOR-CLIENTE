//SERVIDOR

#include <iostream>
#include <thread>
#include <vector>
#include <string>
#include <mutex>
#include <unistd.h>
#include <arpa/inet.h>

using namespace std;

vector<int> clientes;
mutex mtx;

void manejarCliente(int clientSocket) {
    char buffer[1024];
    string mensaje;

    while (true) {
        ssize_t bytesRecibidos = recv(clientSocket, buffer, sizeof(buffer) - 1, 0);
        if (bytesRecibidos <= 0) {
            cout << "Cliente desconectado.\n";
            close(clientSocket);
            mtx.lock();
            clientes.erase(remove(clientes.begin(), clientes.end(), clientSocket), clientes.end());
            mtx.unlock();
            break;
        }

        buffer[bytesRecibidos] = '\0';
        mensaje = buffer;

        cout << "Mensaje recibido: " << mensaje << endl;

        // Reenviar mensaje a todos los demás clientes
        mtx.lock();
        for (int cliente : clientes) {
            if (cliente != clientSocket) {
                send(cliente, mensaje.c_str(), mensaje.size(), 0);
            }
        }
        mtx.unlock();
    }
}

int main() {
    int servidorSocket, nuevoSocket;
    struct sockaddr_in servidorAddr, clienteAddr;
    socklen_t clienteLen = sizeof(clienteAddr);
    const int PORT = 8080;

    servidorSocket = socket(AF_INET, SOCK_STREAM, 0);
    if (servidorSocket == -1) {
        cerr << "Error al crear el socket.\n";
        return -1;
    }

    servidorAddr.sin_family = AF_INET;
    servidorAddr.sin_addr.s_addr = INADDR_ANY;
    servidorAddr.sin_port = htons(PORT);

    if (bind(servidorSocket, (struct sockaddr*)&servidorAddr, sizeof(servidorAddr)) < 0) {
        cerr << "Error en bind.\n";
        return -1;
    }

    if (listen(servidorSocket, 5) < 0) {
        cerr << "Error en listen.\n";
        return -1;
    }

    cout << "Servidor escuchando en el puerto " << PORT << "...\n";

    while (true) {
        nuevoSocket = accept(servidorSocket, (struct sockaddr*)&clienteAddr, &clienteLen);
        if (nuevoSocket < 0) {
            cerr << "Error al aceptar conexión.\n";
            continue;
        }

        mtx.lock();
        clientes.push_back(nuevoSocket);
        mtx.unlock();

        cout << "Nuevo cliente conectado.\n";
        thread hiloCliente(manejarCliente, nuevoSocket);
        hiloCliente.detach(); // hilo independiente
    }

    close(servidorSocket);
    return 0;
}


//CLIENTE

#include <iostream>
#include <thread>
#include <string>
#include <unistd.h>
#include <arpa/inet.h>

using namespace std;

void recibirMensajes(int socketCliente) {
    char buffer[1024];
    while (true) {
        ssize_t bytesRecibidos = recv(socketCliente, buffer, sizeof(buffer) - 1, 0);
        if (bytesRecibidos <= 0) {
            cout << "Conexión cerrada por el servidor.\n";
            close(socketCliente);
            exit(0);
        }
        buffer[bytesRecibidos] = '\0';
        cout << "\n📨 " << buffer << "\n> ";
        fflush(stdout);
    }
}

int main() {
    int socketCliente;
    struct sockaddr_in servidorAddr;
    const int PORT = 8080;
    string ipServidor = "127.0.0.1"; // localhost

    socketCliente = socket(AF_INET, SOCK_STREAM, 0);
    if (socketCliente == -1) {
        cerr << "Error al crear socket.\n";
        return -1;
    }

    servidorAddr.sin_family = AF_INET;
    servidorAddr.sin_port = htons(PORT);
    inet_pton(AF_INET, ipServidor.c_str(), &servidorAddr.sin_addr);

    if (connect(socketCliente, (struct sockaddr*)&servidorAddr, sizeof(servidorAddr)) < 0) {
        cerr << "Error al conectar con el servidor.\n";
        return -1;
    }

    cout << "Conectado al servidor en " << ipServidor << ":" << PORT << endl;

    thread hiloEscucha(recibirMensajes, socketCliente);
    hiloEscucha.detach();

    string mensaje;
    cout << "> ";
    while (true) {
        getline(cin, mensaje);
        if (mensaje == "salir") {
            break;
        }
        send(socketCliente, mensaje.c_str(), mensaje.size(), 0);
    }

    close(socketCliente);
    cout << "Desconectado del servidor.\n";
    return 0;
}
